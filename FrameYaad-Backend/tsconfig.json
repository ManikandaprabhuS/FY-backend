{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "prisma/audit-query-timings.ts",
    "prisma/apply-reviews.ts",
    "prisma/check-reviews.ts",
    "prisma/seed-reviews.ts",
    "scripts/benchmark-notification-reads.ts",
    "scripts/benchmark-wishlist.ts",
    "prisma/audit-duplicates.ts",
    "vitest.config.mts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
